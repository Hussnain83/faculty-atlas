# Faculty Atlas settings. Copy to .env.local (your computer) or paste into
# Vercel → Project → Settings → Environment Variables (the live site).
# Never commit real values. The secret key must never be shared or shown in the browser.

# --- Supabase (Project Settings → API Keys) --------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Who this is for (shown on screens and in examples) --------------------
NEXT_PUBLIC_ORG_NAME=Your University
NEXT_PUBLIC_ORG_SHORT=YourUni
NEXT_PUBLIC_ORG_EMAIL_DOMAIN=your-uni.edu
NEXT_PUBLIC_SUPPORT_EMAIL=research.office@your-uni.edu

# --- Sign-in codes ----------------------------------------------------------
# Must equal Supabase → Authentication → Email → "Email OTP length" (6 recommended).
FA_OTP_LENGTH=6

# --- Demo mode: ONLY for the sample-data demo project -----------------------
# "true" shows sign-in codes on screen instead of emailing them, and shows demo
# sign-in buttons. Leave it out (or "false") for the real site.
FA_DEMO_MODE=false
# Password of the sample accounts (demo project only; not needed in production).
# DEMO_PASSWORD=

# --- Only for local scripts against the demo database -----------------------
# SUPABASE_DB_PASSWORD=
